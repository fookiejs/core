{
  "name": "@fookiejs/otlp",
  "version": "0.1.0",
  "description": "Optional OTLP sink for a fookie app when OTEL_EXPORTER_OTLP_ENDPOINT is set.",
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.203.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.203.0",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-metrics": "^2.0.1",
    "@opentelemetry/sdk-node": "^0.203.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@opentelemetry/semantic-conventions": "^1.36.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"tests/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fookiejs/core.git",
    "directory": "packages/otlp"
  },
  "homepage": "https://github.com/fookiejs/core/tree/main/packages/otlp#readme",
  "bugs": {
    "url": "https://github.com/fookiejs/core/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
