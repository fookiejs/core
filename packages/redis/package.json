{
  "name": "@fookiejs/redis",
  "version": "0.1.0",
  "description": "Redis engine for fookie models. Same query surface as Postgres.",
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fookiejs/core.git",
    "directory": "packages/redis"
  },
  "homepage": "https://github.com/fookiejs/core/tree/main/packages/redis#readme",
  "bugs": {
    "url": "https://github.com/fookiejs/core/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:all": "tsc -p tsconfig.lint.json --noEmit",
    "test": "node --import tsx --experimental-test-module-mocks --test \"tests/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "MIT",
  "peerDependencies": {
    "@fookiejs/core": ">=0.2.4"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "redis": "^5.12.1"
  },
  "devDependencies": {
    "@fookiejs/core": "*",
    "@fookiejs/postgresql": "*",
    "@fookiejs/eslint-plugin": "*",
    "@types/node": "^26.0.1",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.6.0",
    "prettier": "^3.8.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
